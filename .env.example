# SQLite file. On Render/Railway point this at the persistent volume, e.g. /data/app.db
DATABASE_PATH=./data/app.db
# 32+ character secret used to derive the AES-256-GCM key for encrypted columns.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_KEY=replace-me-with-a-long-random-hex-string
